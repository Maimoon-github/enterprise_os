        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% STYLING\n    classDef orch fill:#f3e8fd,stroke:#7c3aed,stroke-width:2px,color:#1e1035;\n    classDef rag fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#0f172a;\n    classDef worker fill:#e0f2fe,stroke:#0284c7,stroke-width:1.5px,color:#082f49;\n    classDef gate fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#451a03;\n    classDef mcp fill:#f1f5f9,stroke:#475569,stroke-width:1.5px,color:#0f172a;\n    classDef db fill:#ede9fe,stroke:#6d28d9,stroke-width:2.5px,color:#2e1065;\n    classDef external fill:#f8fafc,stroke:#94a3b8,stroke-width:1.5px,color:#334155;\n\n    %% 1. PERSISTENT STORAGE &amp; CORE RUNTIME\n    subgraph DATA_TIER [Authoritative Data &amp; System of Record]\n        DB[(\&quot;&lt;b&gt;Central Database&lt;/b&gt;&lt;br/&gt;Single Persistent Source of Truth&lt;br/&gt;&lt;i&gt;(All system data, logs &amp; states)&lt;/i&gt;\&quot;)]:::db\n        WEB[\&quot;&lt;b&gt;Website &amp; Headless CMS&lt;/b&gt;&lt;br/&gt;Storefront • App • Portfolio • Blog\&quot;]:::external\n    end\n\n    %% 2. AUTHORITATIVE DATA MANAGEMENT LAYER\n    subgraph RAG_TIER [Authoritative Data Management]\n        RAG[\&quot;&lt;b&gt;Agentic RAG Engine&lt;/b&gt;&lt;br/&gt;• Full authority over DB &amp; Website&lt;br/&gt;• Write, Index, Vectorize &amp; Sync&lt;br/&gt;• Exclusive Data Bridge to Orchestrator\&quot;]:::rag\n        MCP_DATA[\&quot;&lt;b&gt;Data/CMS MCP&lt;/b&gt;\&quot;]:::mcp\n        RAG &lt;--&gt; MCP_DATA\n        MCP_DATA &lt;==&gt;|Full Write/Read Authority| DB\n        MCP_DATA &lt;==&gt;|Full Deploy/Sync Authority| WEB\n    end\n\n    %% 3. CENTRAL GATEWAY &amp; ORCHESTRATION\n    subgraph ORCH_TIER [Central Gateway &amp; Coordination Plane]\n        ORCH[\&quot;&lt;b&gt;Intelligence Engine (Orchestrator)&lt;/b&gt;&lt;br/&gt;• Single Access-Control Gateway&lt;br/&gt;• Task Contracts &amp; Canonical State&lt;br/&gt;• Policy &amp; Monotonic Attenuation\&quot;]:::orch\n        POLICY[\&quot;&lt;b&gt;Brand Policy &amp; Persona Layer&lt;/b&gt;&lt;br/&gt;Tone, Rules &amp; Compliance\&quot;]:::orch\n        POLICY --&gt;|Enforces Rules| ORCH\n    end\n\n    %% 4. ISOLATED SPECIALIZED AGENTS\n    subgraph AGENTS_TIER [Specialized Agents: Isolated Tools, Skills &amp; Scopes]\n        DEV[\&quot;&lt;b&gt;Development Engine&lt;/b&gt;&lt;br/&gt;Code, CMS schemas, UI components\&quot;]:::worker\n        STRAT[\&quot;&lt;b&gt;Strategy Engine&lt;/b&gt;&lt;br/&gt;Omnichannel plans &amp; budgets\&quot;]:::worker\n        CREATIVE[\&quot;&lt;b&gt;Creative &amp; Content Engine&lt;/b&gt;&lt;br/&gt;Copy, social posts &amp; visual assets\&quot;]:::worker\n        COMP[\&quot;&lt;b&gt;Competitor Intel Engine&lt;/b&gt;&lt;br/&gt;Pricing, ads &amp; market benchmarks\&quot;]:::worker\n        VOICE[\&quot;&lt;b&gt;Customer Voice Engine&lt;/b&gt;&lt;br/&gt;Reviews, sentiment &amp; ticket data\&quot;]:::worker\n        LEARN[\&quot;&lt;b&gt;Learning Engine&lt;/b&gt;&lt;br/&gt;Attribution, decay &amp; analytics\&quot;]:::worker\n    end\n\n    %% 5. GOVERNANCE, ACTUATION &amp; TELEMETRY\n    subgraph ACTION_TIER [Outbound Execution &amp; Telemetry]\n        HITL{\&quot;&lt;b&gt;Human Approval&lt;/b&gt;&lt;br/&gt;Quality &amp; Spend Gate\&quot;}:::gate\n        MCP_ACT[\&quot;&lt;b&gt;Actuation MCP&lt;/b&gt;\&quot;]:::mcp\n        CHANNELS[\&quot;&lt;b&gt;External Channels&lt;/b&gt;&lt;br/&gt;Meta • TikTok • Google • LinkedIn • X\&quot;]:::external\n        PERF[\&quot;&lt;b&gt;Performance Data&lt;/b&gt;&lt;br/&gt;Impressions, CTR, CPA, ROAS, Errors\&quot;]:::external\n    end\n\n    %% ================= RELATIONSHIPS &amp; DATA FLOWS =================\n    %% Exclusive Access: Agentic RAG &lt;==&gt; Intelligence Engine\n    RAG &lt;==&gt;|Exclusive Data Bridge&lt;br/&gt;Read Outputs &amp; Persistence Ingestion| ORCH\n\n    %% Read-Only Requests &amp; Upward Data Submission: Specialized Agents &lt;==&gt; Intelligence Engine\n    DEV &lt;==&gt;|Read-Only Queries / Generated Code &amp; Schemas| ORCH\n    STRAT &lt;==&gt;|Read-Only Queries / Budget &amp; Channel Plans| ORCH\n    CREATIVE &lt;==&gt;|Read-Only Queries / Copy &amp; Content Proposals| ORCH\n    COMP &lt;==&gt;|Read-Only Queries / Scraped Intel &amp; Trends| ORCH\n    VOICE &lt;==&gt;|Read-Only Queries / Customer Sentiment Feeds| ORCH\n    LEARN &lt;==&gt;|Read-Only Queries / Promoted Heuristics| ORCH\n\n    %% Outbound Side-Effect Proposals &amp; Execution\n    ORCH --&gt;|Proposals for Spend, Code &amp; Content| HITL\n    HITL --&gt;|Authorized Grants| MCP_ACT\n    HITL -.-&gt;|Rejection / Redo| ORCH\n    MCP_ACT --&gt;|Campaigns &amp; Social Posts| CHANNELS\n\n    %% Telemetry &amp; Closed-Loop Feedback\n    CHANNELS --&gt; PERF\n    WEB --&gt;|Traffic &amp; Error Logs| PERF\n    PERF --&gt; LEARN\n    LEARN -.-&gt;|&lt;b&gt;Continuous Learning Loop&lt;/b&gt;| ORCH&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jNLb2qwnlkjZBGXYwLNb-44">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
