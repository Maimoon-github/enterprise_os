        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% -------------------------------------------------------------\n    %% STYLING DEFINITIONS\n    %% -------------------------------------------------------------\n    classDef gov fill:#fef2f2,stroke:#ef4444,stroke-width:2px,color:#991b1b;\n    classDef orch fill:#f5f3ff,stroke:#8b5cf6,stroke-width:2px,color:#4c1d95;\n    classDef data fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1e40af;\n    classDef worker fill:#f0fdf4,stroke:#22c55e,stroke-width:1.5px,color:#14532d;\n    classDef subagent fill:#fffbeb,stroke:#f59e0b,stroke-width:1.5px,stroke-dasharray: 3 3,color:#78350f;\n    classDef ext fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#1e293b;\n    classDef audit fill:#fdf4ff,stroke:#d946ef,stroke-width:2px,color:#701a75;\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 1: GOVERNANCE &amp; HITL DECISION PLANE\n    %% -------------------------------------------------------------\n    subgraph G_GOV [\&quot;1. Governance, Policy &amp; Human Oversight Plane\&quot;]\n        USER[\&quot;Business Stakeholders &amp; Brand Managers&lt;br/&gt;&lt;i&gt;(Objectives, Brand Scopes &amp; Budget Envelopes)&lt;/i&gt;\&quot;]:::gov\n        POLICY[\&quot;Enterprise Policy &amp; Brand Boundary Engine&lt;br/&gt;&lt;i&gt;(Multi-Tenant Scopes, Legal Rules &amp; Risk Matrices)&lt;/i&gt;\&quot;]:::gov\n        HITL{\&quot;Human-in-the-Loop (HITL) Gate&lt;br/&gt;&lt;i&gt;(Mandatory Sign-off: Financial, Legal, Security &amp; Deployments)&lt;/i&gt;\&quot;}:::gov\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 2: CENTRAL CONTROL PLANE (INTELLIGENCE ENGINE)\n    %% -------------------------------------------------------------\n    subgraph G_ORCH [\&quot;2. Central Control Plane: Governable Intelligence Engine\&quot;]\n        IE[\&quot;Governable Intelligence Engine (Central Orchestrator / MCP Host)&lt;br/&gt;• Canonical Task State &amp; Execution Graph Engine&lt;br/&gt;• Brand Persona Layer &amp; Dynamic Context Assembly&lt;br/&gt;• Monotonic Grant Attenuation &amp; Tool Allowlisting&lt;br/&gt;• Reconciliation, Escalation &amp; Final Acceptance\&quot;]:::orch\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 3: GOVERNED DATA ACCESS &amp; MEMORY LAYER\n    %% -------------------------------------------------------------\n    subgraph G_DATA [\&quot;3. Governed Data Access, RAG &amp; System of Record\&quot;]\n        RAG[\&quot;Agentic RAG &amp; Access Layer&lt;br/&gt;&lt;i&gt;(Query Rewriting, Tenant Filtering, Freshness Checks &amp; Schema Validation)&lt;/i&gt;\&quot;]:::data\n        MCP_DATA[\&quot;Governed MCP Data &amp; Storage Boundary&lt;br/&gt;&lt;i&gt;(Tenant-Scoped, Read/Write Mediated Gateway)&lt;/i&gt;\&quot;]:::data\n        CDB[(\&quot;Central Enterprise Database&lt;br/&gt;&lt;i&gt;(Catalogs, SKUs, Customer Records, Telemetry)&lt;/i&gt;\&quot;)]:::data\n        CMS[(\&quot;Headless CMS &amp; Media Repository&lt;br/&gt;&lt;i&gt;(Page Models, Content Schemas, Assets)&lt;/i&gt;\&quot;)]:::data\n        MEM[(\&quot;Long-Term &amp; Episodic Memory Registry&lt;br/&gt;&lt;i&gt;(Promoted Heuristics, Learned Personas, Artifacts)&lt;/i&gt;\&quot;)]:::data\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 4: BOUNDED WORKER AGENT LAYER\n    %% -------------------------------------------------------------\n    subgraph G_WORKERS [\&quot;4. Worker Agent Layer: Bounded Domain Execution\&quot;]\n        W_STRAT[\&quot;Strategy Engine&lt;br/&gt;&lt;i&gt;(Omnichannel, Budgets &amp; Funnels)&lt;/i&gt;\&quot;]:::worker\n        W_CREAT[\&quot;Creative &amp; Content Engine&lt;br/&gt;&lt;i&gt;(Hooks, Copy, Visual Briefs)&lt;/i&gt;\&quot;]:::worker\n        W_DEV[\&quot;Development Engine&lt;br/&gt;&lt;i&gt;(CMS Schemas, UI, Site Updates)&lt;/i&gt;\&quot;]:::worker\n        W_PROD[\&quot;Product &amp; Evidence Engine&lt;br/&gt;&lt;i&gt;(Specs, Claims, Compliance)&lt;/i&gt;\&quot;]:::worker\n        W_COMP[\&quot;Competitor Intel Engine&lt;br/&gt;&lt;i&gt;(Pricing, Ad Libraries, Trends)&lt;/i&gt;\&quot;]:::worker\n        W_VOICE[\&quot;Customer Voice Engine&lt;br/&gt;&lt;i&gt;(Reviews, CX Tickets, Sentiment)&lt;/i&gt;\&quot;]:::worker\n        W_LEARN[\&quot;Learning &amp; Performance Engine&lt;br/&gt;&lt;i&gt;(Attribution, Decay &amp; ROAS)&lt;/i&gt;\&quot;]:::worker\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 5: AGENT-SPECIFIC SUB-AGENTS\n    %% -------------------------------------------------------------\n    subgraph G_SUB [\&quot;5. Specialist Sub-Agent Layer: Ephemeral Micro-Executors\&quot;]\n        S_SCRAPE[\&quot;Scraper / Tracker&lt;br/&gt;&lt;i&gt;(Ad &amp; Price Extraction)&lt;/i&gt;\&quot;]:::subagent\n        S_COPY[\&quot;Copy Drafter&lt;br/&gt;&lt;i&gt;(Localized Variations)&lt;/i&gt;\&quot;]:::subagent\n        S_VAL[\&quot;Schema / Claim Validator&lt;br/&gt;&lt;i&gt;(Compliance &amp; Linting)&lt;/i&gt;\&quot;]:::subagent\n        S_PARSE[\&quot;Review / Ticket Parser&lt;br/&gt;&lt;i&gt;(Sentiment Tagging)&lt;/i&gt;\&quot;]:::subagent\n        S_ATTR[\&quot;Attribution Modeler&lt;br/&gt;&lt;i&gt;(ROAS &amp; Decay Scoring)&lt;/i&gt;\&quot;]:::subagent\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 6: OUTBOUND EXECUTION &amp; PLATFORM SURFACES\n    %% -------------------------------------------------------------\n    subgraph G_EXT [\&quot;6. Outbound Actuation &amp; External Digital Channels\&quot;]\n        MCP_ACT[\&quot;Outbound Actuation MCP Boundary&lt;br/&gt;&lt;i&gt;(API Security, Signed Grants &amp; Dispatch)&lt;/i&gt;\&quot;]:::ext\n        CH_ADS[\&quot;Paid Ad Channels&lt;br/&gt;&lt;i&gt;(Meta, Google, TikTok Ads)&lt;/i&gt;\&quot;]:::ext\n        CH_STORE[\&quot;Live Storefront &amp; Web Properties&lt;br/&gt;&lt;i&gt;(Headless Store, Blog, Landing Pages)&lt;/i&gt;\&quot;]:::ext\n        TELEMETRY[\&quot;Omnichannel Telemetry Feed&lt;br/&gt;&lt;i&gt;(Conversions, Webhooks, CTR, ROAS)&lt;/i&gt;\&quot;]:::ext\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 7: AUDIT, LINEAGE &amp; PROVENANCE\n    %% -------------------------------------------------------------\n    subgraph G_AUDIT [\&quot;7. Audit &amp; Provenance Authority\&quot;]\n        AUDIT[(\&quot;W3C PROV Immutable Audit Trail&lt;br/&gt;&lt;i&gt;(Lifecycle States, Invocations, HITL Decisions, Grants)&lt;/i&gt;\&quot;)]:::audit\n    end\n\n    %% =============================================================\n    %% INTER-COMPONENT RELATIONSHIPS &amp; CONTROL FLOWS\n    %% =============================================================\n    \n    %% Intake &amp; Policy Injection\n    USER --&gt;|\&quot;1. Objective, Tenant Context &amp; Budget\&quot;| IE\n    POLICY --&gt;|\&quot;Brand Policy, Guardrails &amp; Personas\&quot;| IE\n    IE &lt;--&gt;|\&quot;6. Action Previews, Dossiers &amp; Sign-off\&quot;| HITL\n\n    %% Central Storage &amp; Mediated Retrieval\n    IE &lt;--&gt;|\&quot;3. Filtered Inquiries &amp; Canonical State Sync\&quot;| RAG\n    RAG &lt;--&gt; MCP_DATA\n    MCP_DATA &lt;--&gt; CDB\n    MCP_DATA &lt;--&gt; CMS\n    MCP_DATA &lt;--&gt; MEM\n\n    %% Downward Bounded Task Grants (Monotonic Attenuation)\n    IE ==&gt;|\&quot;2. Bounded Task Grants (Scope, Token Budget, Stop Rules)\&quot;| W_STRAT\n    IE ==&gt;|\&quot;2. Bounded Task Grants\&quot;| W_CREAT\n    IE ==&gt;|\&quot;2. Bounded Task Grants\&quot;| W_DEV\n    IE ==&gt;|\&quot;2. Bounded Task Grants\&quot;| W_PROD\n    IE ==&gt;|\&quot;2. Bounded Task Grants\&quot;| W_COMP\n    IE ==&gt;|\&quot;2. Bounded Task Grants\&quot;| W_VOICE\n    IE ==&gt;|\&quot;2. Bounded Task Grants\&quot;| W_LEARN\n\n    %% Worker to Sub-Agent Invocation (Ephemeral)\n    W_COMP -.-&gt;|\&quot;4. Scrape Mandate\&quot;| S_SCRAPE\n    W_CREAT -.-&gt;|\&quot;4. Drafting Mandate\&quot;| S_COPY\n    W_DEV -.-&gt;|\&quot;4. Validation Mandate\&quot;| S_VAL\n    W_PROD -.-&gt;|\&quot;4. Compliance Mandate\&quot;| S_VAL\n    W_VOICE -.-&gt;|\&quot;4. Parsing Mandate\&quot;| S_PARSE\n    W_LEARN -.-&gt;|\&quot;4. Modeling Mandate\&quot;| S_ATTR\n\n    %% Sub-Agent Upward Evidence Returns\n    S_SCRAPE -.-&gt;|\&quot;Market Signals\&quot;| W_COMP\n    S_COPY -.-&gt;|\&quot;Draft Variants\&quot;| W_CREAT\n    S_VAL -.-&gt;|\&quot;Linting / Claim Dossiers\&quot;| W_DEV\n    S_VAL -.-&gt;|\&quot;Verified Evidence\&quot;| W_PROD\n    S_PARSE -.-&gt;|\&quot;Sentiment Metrics\&quot;| W_VOICE\n    S_ATTR -.-&gt;|\&quot;Attribution Deltas\&quot;| W_LEARN\n\n    %% Worker Upward Evidence Envelopes to Orchestrator\n    W_STRAT --&gt;|\&quot;5. Spend Proposals\&quot;| IE\n    W_CREAT --&gt;|\&quot;5. Creative Packages\&quot;| IE\n    W_DEV --&gt;|\&quot;5. CMS / Code Diffs\&quot;| IE\n    W_PROD --&gt;|\&quot;5. Compliance Dossiers\&quot;| IE\n    W_COMP --&gt;|\&quot;5. Market Intel\&quot;| IE\n    W_VOICE --&gt;|\&quot;5. Voice Signals\&quot;| IE\n    W_LEARN --&gt;|\&quot;5. Performance Insights\&quot;| IE\n\n    %% Outbound Execution Post-HITL\n    HITL --&gt;|\&quot;Post-Approval Execution Grant\&quot;| IE\n    IE ==&gt;|\&quot;7. Validated Directives\&quot;| MCP_ACT\n    MCP_ACT --&gt;|\&quot;Live Campaigns\&quot;| CH_ADS\n    MCP_ACT --&gt;|\&quot;Staged / Prod Deploys\&quot;| CH_STORE\n\n    %% Continuous Feedback Loop\n    CH_ADS --&gt;|\&quot;Raw Performance\&quot;| TELEMETRY\n    CH_STORE --&gt;|\&quot;Store Traffic &amp; Orders\&quot;| TELEMETRY\n    TELEMETRY --&gt;|\&quot;Aggregated Telemetry\&quot;| W_LEARN\n    W_LEARN -.-&gt;|\&quot;8. Continuous Learning Loop (Memory Promotion)\&quot;| IE\n\n    %% Universal Provenance &amp; Audit Logging\n    IE -.- AUDIT\n    HITL -.- AUDIT\n    RAG -.- AUDIT\n    MCP_ACT -.- AUDIT&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0dD2iXvc-z2Y17BT7p3l-66">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
