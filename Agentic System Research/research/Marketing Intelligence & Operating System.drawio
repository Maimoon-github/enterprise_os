        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% STYLES &amp; CLASSES\n    classDef governance fill:#e8f0fe,stroke:#1a73e8,stroke-width:2px,color:#174ea6;\n    classDef orchestrator fill:#f3e8fd,stroke:#7b1fa2,stroke-width:2px,color:#4a148c;\n    classDef rag fill:#e0f2f1,stroke:#00796b,stroke-width:2px,color:#004d40;\n    classDef worker fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20;\n    classDef subagent fill:#fff3e0,stroke:#e65100,stroke-width:1.5px,stroke-dasharray: 3 3,color:#bf360c;\n    classDef storage fill:#ede7f6,stroke:#512da8,stroke-width:2px,color:#311b92;\n    classDef gate fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,color:#f57f17;\n    classDef external fill:#fce4ec,stroke:#c2185b,stroke-width:1.5px,color:#880e4f;\n\n    %% -------------------------------------------------------------\n    %% LAYER 0: HUMAN GOVERNANCE &amp; BUSINESS STAKEHOLDERS\n    %% -------------------------------------------------------------\n    subgraph L0[\&quot;Human Governance &amp; Decision Layer\&quot;]\n        USER[\&quot;Business Stakeholder / Client / Brand Owner\\n(Objective Definition, Context &amp; Constraints)\&quot;]:::governance\n        HITL{\&quot;Human-in-the-Loop (HITL) Gate\\n[Quality, Financial, Legal, Security &amp; Release Approval]\&quot;}:::gate\n    end\n\n    %% -------------------------------------------------------------\n    %% LAYER 1: GOVERNABLE INTELLIGENCE ENGINE (ORCHESTRATOR)\n    %% -------------------------------------------------------------\n    subgraph L1[\&quot;Governable Intelligence Engine (Central Orchestrator)\&quot;]\n        IE[\&quot;Brand Persona &amp; Intelligence Engine\\n• Canonical Task State &amp; Lifecycle Owner\\n• Global Decomposition &amp; Policy Enforcement\\n• Context Assembly &amp; Dynamic Capability Routing\\n• Synthesis, Validation, Audit &amp; Recovery Control\&quot;]:::orchestrator\n        POL[\&quot;Policy &amp; Authorization Boundary\\n(Monotonic Attenuation, Scope &amp; Risk Tiers)\&quot;]:::orchestrator\n        IE &lt;--&gt; POL\n    end\n\n    USER --&gt;|\&quot;Objective &amp; Tenant Scope\&quot;| IE\n    IE &lt;--&gt;|\&quot;Action Previews &amp; Approval Requests\&quot;| HITL\n\n    %% -------------------------------------------------------------\n    %% LAYER 2: AGENTIC RAG &amp; GOVERNED DATA ACCESS LAYER\n    %% -------------------------------------------------------------\n    subgraph L2[\&quot;Agentic RAG &amp; Governed Data Access Layer\&quot;]\n        RAG[\&quot;Agentic RAG &amp; Access Controller\\n(Retrieval, Policy Filtering, Ranking, Provenance, Freshness Checks)\&quot;]:::rag\n        MCP_DATA[\&quot;Governed MCP Data Boundary\\n(Tenant-Scoped, Read-Only Capability Façades)\&quot;]:::rag\n        RAG &lt;--&gt; MCP_DATA\n    end\n\n    IE &lt;--&gt;|\&quot;Authorized Read-Only Data Queries\\n&amp; Governed State Writes\&quot;| RAG\n\n    %% -------------------------------------------------------------\n    %% CENTRAL ENTERPRISE DATA &amp; EXTERNAL PLATFORMS\n    %% -------------------------------------------------------------\n    subgraph L_DATA[\&quot;Central Enterprise Stores &amp; Connected Platforms\&quot;]\n        CDB[(\&quot;Central Enterprise Database\\n[Canonical Data, Schemas, Lineage]\&quot;)]:::storage\n        CMS[(\&quot;Website &amp; Headless CMS\\n[Catalog, Pages, Product Models]\&quot;)]:::storage\n        MEM_STORE[(\&quot;Governed Memory &amp; Knowledge Store\\n[Promoted Long-Term Memory, Brand Books]\&quot;)]:::storage\n        EXT_CHANNELS[\&quot;External Channels &amp; Ad Platforms\\n[Meta, TikTok, Google Ads, Marketplaces]\&quot;]:::external\n    end\n\n    MCP_DATA &lt;--&gt;|\&quot;Filtered Retrieval &amp; Verified Schema Sync\&quot;| CDB\n    MCP_DATA &lt;--&gt;|\&quot;Staged Content Sync &amp; Schema Queries\&quot;| CMS\n    MCP_DATA &lt;--&gt;|\&quot;Scoped Knowledge &amp; Provenance Query\&quot;| MEM_STORE\n\n    %% -------------------------------------------------------------\n    %% LAYER 3: WORKER AGENTS (DOMAIN WORKSTREAM OWNERS)\n    %% -------------------------------------------------------------\n    subgraph L3[\&quot;Worker Agents (Bounded Domain Execution Contexts)\&quot;]\n        WA_STRAT[\&quot;Strategy Engine\\n• Omnichannel Plans\\n• Budget &amp; Campaigns\&quot;]:::worker\n        WA_CREAT[\&quot;Creative &amp; Content Engine\\n• Copy &amp; Visual Proposals\\n• Social &amp; Campaign Content\&quot;]:::worker\n        WA_DEV[\&quot;Development Engine\\n• Code Proposals &amp; UI\\n• CMS Schemas &amp; Layouts\&quot;]:::worker\n        WA_SPEC[\&quot;Specialized Agents\\n(Product / Evidence Engine)\\n• Product Claims &amp; Specs\\n• Scientific Proof Packages\&quot;]:::worker\n        WA_COMP[\&quot;Competitor Intel Engine\\n• Competitor Benchmarks\\n• Pricing &amp; Ad Monitoring\&quot;]:::worker\n        WA_VOICE[\&quot;Customer Voice Engine\\n• Reviews, CX &amp; Feedback\\n• Sentiment Analysis\&quot;]:::worker\n        WA_LEARN[\&quot;Learning Engine\\n• Attribution &amp; Decay Analytics\\n• Performance Optimization\&quot;]:::worker\n    end\n\n    %% Intelligence Engine to Worker Agents (Control / Data Downward and Upward)\n    IE --&gt;|\&quot;Bounded Task Grants\\n(Scope, Budget, Constraints)\&quot;| L3\n    L3 --&gt;|\&quot;Validated Findings, Evidence Packages,\\nProposed State Deltas &amp; Artifact References\&quot;| IE\n\n    %% -------------------------------------------------------------\n    %% LAYER 4: AGENT-SPECIFIC SUB-AGENTS (SPECIALIST EXECUTION)\n    %% -------------------------------------------------------------\n    subgraph L4[\&quot;Agent-Specific Sub-Agents (Narrow Specialist Scope)\&quot;]\n        SA_STRAT[\&quot;Media Planner /\\nBudget Allocator\&quot;]:::subagent\n        SA_CREAT[\&quot;Copy Drafter /\\nAsset Generator\&quot;]:::subagent\n        SA_DEV[\&quot;Component Coder /\\nSchema Validator\&quot;]:::subagent\n        SA_SPEC[\&quot;Dossier Validator /\\nClaim Verifier\&quot;]:::subagent\n        SA_COMP[\&quot;Price Scraper /\\nAd Library Tracker\&quot;]:::subagent\n        SA_VOICE[\&quot;Sentiment Parser /\\nTicket Classifier\&quot;]:::subagent\n        SA_LEARN[\&quot;Attribution Modeler /\\nROAS Analyzer\&quot;]:::subagent\n    end\n\n    WA_STRAT --&gt;|\&quot;Narrow Subtask\&quot;| SA_STRAT\n    WA_CREAT --&gt;|\&quot;Narrow Subtask\&quot;| SA_CREAT\n    WA_DEV --&gt;|\&quot;Narrow Subtask\&quot;| SA_DEV\n    WA_SPEC --&gt;|\&quot;Narrow Subtask\&quot;| SA_SPEC\n    WA_COMP --&gt;|\&quot;Narrow Subtask\&quot;| SA_COMP\n    WA_VOICE --&gt;|\&quot;Narrow Subtask\&quot;| SA_VOICE\n    WA_LEARN --&gt;|\&quot;Narrow Subtask\&quot;| SA_LEARN\n\n    SA_STRAT -.-&gt;|\&quot;Findings &amp; Artifacts\&quot;| WA_STRAT\n    SA_CREAT -.-&gt;|\&quot;Draft Assets\&quot;| WA_CREAT\n    SA_DEV -.-&gt;|\&quot;Code Deltas\&quot;| WA_DEV\n    SA_SPEC -.-&gt;|\&quot;Verification Docs\&quot;| WA_SPEC\n    SA_COMP -.-&gt;|\&quot;Market Signals\&quot;| WA_COMP\n    SA_VOICE -.-&gt;|\&quot;Customer Insights\&quot;| WA_VOICE\n    SA_LEARN -.-&gt;|\&quot;Attribution Deltas\&quot;| WA_LEARN\n\n    %% -------------------------------------------------------------\n    %% LAYER 5: GOVERNED MCP CAPABILITY &amp; EXECUTION PERIMETER\n    %% -------------------------------------------------------------\n    subgraph L5[\&quot;Governed MCP Capability &amp; Execution Perimeter\&quot;]\n        MCP_EXEC[\&quot;Model Context Protocol (MCP) Host / Client Gateway\\n• Dynamic Capability Projection (Tools, Prompts, Resources, Skills)\\n• Strict Least-Privilege Execution (No Ambient Lateral Authority)\&quot;]:::governance\n    end\n\n    %% Execution Routing\n    HITL --&gt;|\&quot;Post-Approval Release Directive\&quot;| IE\n    IE --&gt;|\&quot;Authorized Execution Directives\&quot;| MCP_EXEC\n    MCP_EXEC --&gt;|\&quot;Governed API Deployment\&quot;| CMS\n    MCP_EXEC --&gt;|\&quot;Campaign Publishes &amp; Bidding\&quot;| EXT_CHANNELS\n\n    %% Continuous Feedback / Learning Loop\n    EXT_CHANNELS -.-&gt;|\&quot;Performance Telemetry &amp; Ad Data\&quot;| MCP_DATA\n    WA_LEARN -.-&gt;|\&quot;Continuous Learning Loop\\n(Validated Feedback Signals)\&quot;| IE\n\n    %% -------------------------------------------------------------\n    %% AUDIT, OBSERVABILITY &amp; PROVENANCE LAYER\n    %% -------------------------------------------------------------\n    subgraph L_AUDIT[\&quot;Audit, Lineage &amp; Provenance Authority\&quot;]\n        AUDIT[(\&quot;Immutable Audit Trail &amp; Provenance Registry\\n(W3C PROV: Entities, Activities, Delegations, Invocations, Approvals)\&quot;)]:::storage\n    end\n\n    IE -.-&gt;|\&quot;Record Every State Transition &amp; Grant\&quot;| AUDIT\n    POL -.-&gt;|\&quot;Policy Evaluations &amp; Invocations\&quot;| AUDIT\n    HITL -.-&gt;|\&quot;Human Decisions &amp; Overrides\&quot;| AUDIT\n    RAG -.-&gt;|\&quot;Retrieval Queries &amp; Freshness Flags\&quot;| AUDIT&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jNLb2qwnlkjZBGXYwLNb-85">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
