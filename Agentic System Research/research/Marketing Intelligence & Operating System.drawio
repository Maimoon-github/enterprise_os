        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% -------------------------------------------------------------\n    %% STYLES &amp; CLASSES\n    %% -------------------------------------------------------------\n    classDef control fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#ffffff;\n    classDef gov fill:#450a0a,stroke:#f87171,stroke-width:2px,color:#ffffff;\n    classDef data fill:#0f172a,stroke:#818cf8,stroke-width:2px,color:#ffffff;\n    classDef worker fill:#14532d,stroke:#4ade80,stroke-width:2px,color:#ffffff;\n    classDef subagent fill:#064e3b,stroke:#34d399,stroke-width:1px,stroke-dasharray: 4 2,color:#ffffff;\n    classDef external fill:#3b0764,stroke:#c084fc,stroke-width:2px,color:#ffffff;\n    classDef audit fill:#312e81,stroke:#a5b4fc,stroke-width:2px,color:#ffffff;\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 1: GOVERNANCE &amp; HITL\n    %% -------------------------------------------------------------\n    subgraph SUB_GOV [\&quot;1. Governance &amp; Oversight\&quot;]\n        HITL[\&quot;Human-in-the-Loop Gatekeeper&lt;br/&gt;(Action-Specific Authorization / Approval)\&quot;]:::gov\n        POLICY[\&quot;Enterprise Policy Engine&lt;br/&gt;(Tenant Rules, Claims &amp; Risk Matrices)\&quot;]:::gov\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 2: CENTRAL CONTROL PLANE\n    %% -------------------------------------------------------------\n    subgraph SUB_ORCH [\&quot;2. Central Control Plane: Governable Intelligence Engine\&quot;]\n        ORCH[\&quot;Governable Orchestrator (MCP Host)&lt;br/&gt;• Canonical Task State Machine&lt;br/&gt;• Dynamic Persona &amp; Context Assembly&lt;br/&gt;• Monotonic Grant Attenuation&lt;br/&gt;• Validation &amp; Reconciliation\&quot;]:::control\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 3: DATA-ACCESS &amp; STORAGE PLANE\n    %% -------------------------------------------------------------\n    subgraph SUB_DATA [\&quot;3. Governed Data-Access Layer &amp; Central Storage\&quot;]\n        RAG[\&quot;Agentic RAG Gateway&lt;br/&gt;(Schema-Aware, Tenant Filter, Freshness Checks)\&quot;]:::data\n        CDB[(\&quot;Central Enterprise DB &amp; Headless CMS&lt;br/&gt;(Multi-Tenant Catalogs, Schemas, Assets)\&quot;)]:::data\n        MEM[(\&quot;Enterprise Memory &amp; Artifact Registry&lt;br/&gt;(Long-Term Learnings, Immutable Artifacts)\&quot;)]:::data\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 4: BOUNDED WORKER ENGINES\n    %% -------------------------------------------------------------\n    subgraph SUB_WORKERS [\&quot;4. Execution Layer: Bounded Worker Engines\&quot;]\n        direction TB\n        W_STRAT[\&quot;Strategy Engine&lt;br/&gt;(Roadmaps, Allocation)\&quot;]:::worker\n        W_CREAT[\&quot;Creative &amp; Content Engine&lt;br/&gt;(Hooks, Copy, Visuals)\&quot;]:::worker\n        W_DEV[\&quot;Development Engine&lt;br/&gt;(UI, CMS Schemas, Code)\&quot;]:::worker\n        W_PROD[\&quot;Product &amp; Evidence Engine&lt;br/&gt;(Claims, Compliance, Dossiers)\&quot;]:::worker\n        W_INTEL[\&quot;Competitor Intel Engine&lt;br/&gt;(Pricing, Ads, Benchmarks)\&quot;]:::worker\n        W_VOICE[\&quot;Customer Voice Engine&lt;br/&gt;(Reviews, Sentiment, CX)\&quot;]:::worker\n        W_LEARN[\&quot;Learning Engine&lt;br/&gt;(Attribution, ROAS, Decay)\&quot;]:::worker\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 5: SPECIALIST SUB-AGENTS\n    %% -------------------------------------------------------------\n    subgraph SUB_AGENTS [\&quot;5. Specialist Layer: Ephemeral Sub-Agents\&quot;]\n        S_SCRAPE[\&quot;Intel / Price Scrapers\&quot;]:::subagent\n        S_GEN[\&quot;Asset / Copy Generators\&quot;]:::subagent\n        S_VAL[\&quot;Schema / Claim Validators\&quot;]:::subagent\n        S_SENT[\&quot;Sentiment / Review Parsers\&quot;]:::subagent\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 6: EXTERNAL RUNTIMES &amp; CONTINUOUS LEARNING\n    %% -------------------------------------------------------------\n    subgraph SUB_EXT [\&quot;6. Production, Ad Platforms &amp; Feedback Surface\&quot;]\n        PROD_SYS[\&quot;Production Operations&lt;br/&gt;(Headless CMS, E-Commerce, Web)\&quot;]:::external\n        AD_PLAT[\&quot;External Ad Channels&lt;br/&gt;(Meta, Google, TikTok)\&quot;]:::external\n        PERF_DATA[\&quot;Omnichannel Telemetry&lt;br/&gt;(Conversions, ROAS, User Engagement)\&quot;]:::external\n    end\n\n    %% -------------------------------------------------------------\n    %% SUBGRAPH 7: AUDIT &amp; PROVENANCE\n    %% -------------------------------------------------------------\n    subgraph SUB_AUDIT [\&quot;7. Audit &amp; Lineage\&quot;]\n        W3C_AUDIT[(\&quot;W3C PROV Immutable Audit Ledger&lt;br/&gt;(Traceability, Grants, Execution Logs)\&quot;)]:::audit\n    end\n\n    %% -------------------------------------------------------------\n    %% CONNECTIONS &amp; FLOWS\n    %% -------------------------------------------------------------\n    %% Governance to Orchestrator\n    POLICY --&gt;|Policy Boundaries &amp; Brand Personas| ORCH\n    ORCH &lt;--&gt;|Action Previews &amp; HITL Approvals| HITL\n\n    %% Orchestrator to Data &amp; Memory\n    ORCH &lt;--&gt;|Mediated Read/Query Intent| RAG\n    RAG &lt;--&gt;|Scoped Retrieval &amp; Filtering| CDB\n    ORCH &lt;--&gt;|Register Artifacts &amp; Retrieve Memory| MEM\n\n    %% Downward Bounded Delegation (Orchestrator to Workers)\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_STRAT\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_CREAT\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_DEV\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_PROD\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_INTEL\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_VOICE\n    ORCH ==&gt;|Bounded Task Grants: Scope, Budget, Context| W_LEARN\n\n    %% Worker to Sub-Agent Delegation\n    W_CREAT -.-&gt;|Narrow Subtask| S_GEN\n    W_DEV -.-&gt;|Syntax / Lint Subtask| S_VAL\n    W_PROD -.-&gt;|Regulatory Verification| S_VAL\n    W_INTEL -.-&gt;|Scrape / Ingest| S_SCRAPE\n    W_VOICE -.-&gt;|Classification| S_SENT\n\n    %% Upward Evidence &amp; Candidate Flow\n    S_GEN -.-&gt;|Candidate Artifacts| W_CREAT\n    S_VAL -.-&gt;|Validation Reports| W_DEV\n    S_VAL -.-&gt;|Evidence Dossiers| W_PROD\n    S_SCRAPE -.-&gt;|Raw Observation Data| W_INTEL\n    S_SENT -.-&gt;|Sentiment Metrics| W_VOICE\n\n    W_STRAT --&gt;|Proposals &amp; Allocation Plans| ORCH\n    W_CREAT --&gt;|Creative Drafts &amp; Briefs| ORCH\n    W_DEV --&gt;|Validated Code &amp; Schema Changes| ORCH\n    W_PROD --&gt;|Compliance Dossiers| ORCH\n    W_INTEL --&gt;|Competitive Signals| ORCH\n    W_VOICE --&gt;|Customer Journey Insights| ORCH\n\n    %% External Execution (Via Orchestrator / MCP Perimeter)\n    ORCH ==&gt;|Governed Release Post-HITL| PROD_SYS\n    ORCH ==&gt;|Governed Campaign Launch Post-HITL| AD_PLAT\n\n    %% Continuous Learning Loop\n    AD_PLAT --&gt;|Raw Performance Data| PERF_DATA\n    PROD_SYS --&gt;|Store Conversion Metrics| PERF_DATA\n    PERF_DATA --&gt;|Attribution &amp; Telemetry Feed| W_LEARN\n    W_LEARN --&gt;|Validated Feedback Signals| ORCH\n\n    %% Lineage and Audit\n    ORCH -.-&gt;|Immutable Activity &amp; State Deltas| W3C_AUDIT\n    HITL -.-&gt;|Human Decision Record| W3C_AUDIT&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0dD2iXvc-z2Y17BT7p3l-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
