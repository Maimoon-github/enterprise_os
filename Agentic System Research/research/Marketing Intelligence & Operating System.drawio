        <UserObject label="Long-Term &amp; Episodic Memory Registry&#xa;&lt;i&gt;(Promoted Heuristics, Learned Personas, Artifacts)&lt;/i&gt;" mermaidId="n:MEM" mermaidBaseStyle="html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;strokeWidth=2;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e40af;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Long-Term &amp; Episodic Memory Registry&#xa;&lt;i&gt;(Promoted Heuristics, Learned Personas, Artifacts)&lt;/i&gt;" id="0dD2iXvc-z2Y17BT7p3l-78">
