        <UserObject label="&lt;b&gt;eDerma Database&lt;/b&gt;&#xa;SKUs, Inventory, Orders" mermaidId="n:DB" mermaidBaseStyle="html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;strokeWidth=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;eDerma Database&lt;/b&gt;&#xa;SKUs, Inventory, Orders" id="CUDhMBtbQreBq1B5f8Qv-103">
