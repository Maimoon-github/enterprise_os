  <diagram name="Page-1" id="EUOGiuqsiag1GNpZ952h">
    <mxGraphModel dx="12720" dy="6250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% eDerma governed agentic AI architecture — surface level\nflowchart TB\n    U[Users and business channels\\nWebsite • customer interactions • internal teams]\n\n    subgraph CONTROL[1. Governance and control]\n        INTAKE[Task intake\\nIntent • purpose • scope • risk]\n        ORCH[eDerma Governable Orchestrator\\nCoordinates • delegates • tracks state\\nApplies policy • routes approval • accepts results]\n        DECIDE{Human approval\\nrequired?}\n        HITL[Authorized human reviewer\\nApprove • revise • reject • pause]\n        RECOVER[Escalate, revise, or stop]\n        AUDIT[Observability and evaluation\\nQuality • safety • provenance • feedback]\n        INTAKE --&gt; ORCH --&gt; DECIDE\n        DECIDE --&gt;|Yes| HITL --&gt;|Decision and constraints| ORCH\n        HITL --&gt;|Rejected or paused| RECOVER --&gt; ORCH\n    end\n\n    U --&gt; INTAKE\n\n    subgraph WORK[2. Worker-agent layer — bounded workstreams]\n        PLAN[Workstream planning and capability routing]\n        COMP[Competitor intelligence\\nMarket and competitor view]\n        VOICE[Customer voice\\nFeedback and sentiment view]\n        STRAT[Strategy\\nStrategic interpretation]\n        CREATIVE[Creative\\nContent and campaign direction]\n        PRODUCT[Product and evidence\\nEvidence and product view]\n        PLAN --&gt; COMP\n        PLAN --&gt; VOICE\n        PLAN --&gt; STRAT\n        PLAN --&gt; CREATIVE\n        PLAN --&gt; PRODUCT\n    end\n\n    DECIDE --&gt;|No / within policy| PLAN\n    ORCH -. bounded task grant .-&gt; PLAN\n\n    subgraph SUB[3. Agent-specific sub-agent layer — narrow specialist tasks]\n        SCOMP[Research • compare • validate]\n        SVOICE[Classify • summarize • detect themes]\n        SSTRAT[Analyze options • test assumptions]\n        SCREATIVE[Draft • critique • adapt]\n        SPRODUCT[Verify evidence • map claims]\n        COMP --&gt; SCOMP\n        VOICE --&gt; SVOICE\n        STRAT --&gt; SSTRAT\n        CREATIVE --&gt; SCREATIVE\n        PRODUCT --&gt; SPRODUCT\n    end\n\n    subgraph CAP[4. Shared governed capability and knowledge boundary]\n        ROUTE[Capability routing\\nSkills • approved tools • scoped permissions]\n        MCP[MCP access boundary\\nAuthorized tools • resources • prompts]\n        RETRIEVE[Agentic RAG and data access\\nSearch • filter • rank • freshness • provenance]\n        MEMORY[Memory and context\\nSession context • durable memory • task state]\n        ARTIFACT[Artifacts and evidence\\nSources • outputs • lineage • versions]\n        ROUTE --&gt; MCP --&gt; RETRIEVE\n        ROUTE --&gt; MEMORY\n        ROUTE --&gt; ARTIFACT\n    end\n\n    ORCH -. policy envelope .-&gt; ROUTE\n    PLAN -. approved capability request .-&gt; ROUTE\n    SCOMP -. narrow request .-&gt; ROUTE\n    SVOICE -. narrow request .-&gt; ROUTE\n    SSTRAT -. narrow request .-&gt; ROUTE\n    SCREATIVE -. narrow request .-&gt; ROUTE\n    SPRODUCT -. narrow request .-&gt; ROUTE\n    RETRIEVE -. approved context and evidence .-&gt; SCOMP\n    RETRIEVE -. approved context and evidence .-&gt; SVOICE\n    RETRIEVE -. approved context and evidence .-&gt; SSTRAT\n    RETRIEVE -. approved context and evidence .-&gt; SCREATIVE\n    RETRIEVE -. approved context and evidence .-&gt; SPRODUCT\n    MEMORY -. governed context and state .-&gt; ORCH\n    ARTIFACT -. evidence and artifact references .-&gt; ORCH\n\n    subgraph EXT[5. External sources and services]\n        SOCIAL[External channels\\nMeta • TikTok • Google]\n        CRM[Customer and product data]\n        DB[Authoritative databases and records]\n        API[Approved external APIs and services]\n    end\n\n    SOCIAL --&gt; MCP\n    CRM --&gt; MCP\n    DB --&gt; RETRIEVE\n    API --&gt; MCP\n\n    SCOMP --&gt;|Validated findings| COMP\n    SVOICE --&gt;|Validated themes| VOICE\n    SSTRAT --&gt;|Options and rationale| STRAT\n    SCREATIVE --&gt;|Drafts and critiques| CREATIVE\n    SPRODUCT --&gt;|Verified claims| PRODUCT\n\n    COMP --&gt; ORCH\n    VOICE --&gt; ORCH\n    STRAT --&gt; ORCH\n    CREATIVE --&gt; ORCH\n    PRODUCT --&gt; ORCH\n\n    ORCH --&gt;|Synthesized result, status, evidence| OUT[Business outcome\\nDecision support • approved content • action proposal]\n    OUT --&gt; AUDIT\n    AUDIT --&gt;|Feedback and lessons| MEMORY\n    AUDIT --&gt;|Policy or routing adjustment| ORCH\n    AUDIT -. continuous learning .-&gt; PLAN\n\n    classDef control fill:#eadcff,stroke:#7c3aed,color:#21113d,stroke-width:2px;\n    classDef worker fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:1.5px;\n    classDef sub fill:#ede9fe,stroke:#6d28d9,color:#2e1065;\n    classDef capability fill:#fef3c7,stroke:#d97706,color:#451a03,stroke-width:1.5px;\n    classDef external fill:#f3f4f6,stroke:#6b7280,color:#111827;\n    classDef decision fill:#e5e7eb,stroke:#4b5563,color:#111827;\n    classDef outcome fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:1.5px;\n\n    class INTAKE,ORCH,HITL,RECOVER,AUDIT control;\n    class PLAN,COMP,VOICE,STRAT,CREATIVE,PRODUCT worker;\n    class SCOMP,SVOICE,SSTRAT,SCREATIVE,SPRODUCT sub;\n    class ROUTE,MCP,RETRIEVE,MEMORY,ARTIFACT capability;\n    class SOCIAL,CRM,DB,API,U external;\n    class DECIDE decision;\n    class OUT outcome;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CUDhMBtbQreBq1B5f8Qv-91">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;editIcon=1;groupPadding=10;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1753" width="8380" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% STYLING\n    classDef orchestrator fill:#f3e8fd,stroke:#7c3aed,stroke-width:2px,color:#1e1035;\n    classDef worker fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#082f49;\n    classDef hitl fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#451a03;\n    classDef mcp fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#0f172a;\n    classDef external fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#334155;\n    classDef feedback fill:#ffedd5,stroke:#ea580c,stroke-dasharray: 5 5,stroke-width:2px,color:#7c2d12;\n\n    %% GOVERNANCE &amp; ORCHESTRATION PLANE\n    subgraph ORCH_PLANE [1. Governable Control Plane]\n        ORCH[\&quot;&lt;b&gt;eDerma Intelligence Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Governable Orchestrator)&lt;/i&gt;&lt;br/&gt;• Brand Persona &amp; Boundary Enforcement&lt;br/&gt;• Canonical Task State &amp; Delegation Grants&lt;br/&gt;• Synthesis &amp; Strategy Prioritization\&quot;]:::orchestrator\n        PERSONA[\&quot;&lt;b&gt;eDerma Persona Layer&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Brand Voice, Clinical Tone &amp; Constraints&lt;/i&gt;\&quot;]:::orchestrator\n        PERSONA -.-&gt; ORCH\n    end\n\n    %% WORKER AGENT LAYER - INTELLIGENCE &amp; INGESTION\n    subgraph INTEL_WORKERS [2. Upstream Intelligence Workers]\n        COMP[\&quot;&lt;b&gt;Competitor Intel Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Worker Agent)&lt;/i&gt;&lt;br/&gt;Market trends &amp; pricing\&quot;]:::worker\n        VOICE[\&quot;&lt;b&gt;Customer Voice Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Worker Agent)&lt;/i&gt;&lt;br/&gt;Reviews, sentiment &amp; pain points\&quot;]:::worker\n        RAG_MGR[\&quot;&lt;b&gt;Product / Evidence Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Worker Agent / RAG Manager)&lt;/i&gt;&lt;br/&gt;Clinical claims &amp; formulations\&quot;]:::worker\n    end\n\n    %% DATA LAYER &amp; INBOUND MCP\n    subgraph DATA_PLANE [3. Knowledge &amp; Retrieval Layer]\n        MCP_DATA[\&quot;&lt;b&gt;Data Access MCP Boundary&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Policy Filtering &amp; Row-Level Security&lt;/i&gt;\&quot;]:::mcp\n        DB[(\&quot;&lt;b&gt;eDerma Database&lt;/b&gt;&lt;br/&gt;SKUs, Inventory, Orders\&quot;)]:::external\n        WEB[\&quot;&lt;b&gt;Brand Website &amp; Store&lt;/b&gt;&lt;br/&gt;Catalog &amp; Documentation\&quot;]:::external\n    end\n\n    %% WORKER AGENT LAYER - PLANNING &amp; CREATIVE\n    subgraph SYNTH_WORKERS [4. Downstream Production Workers]\n        STRAT[\&quot;&lt;b&gt;Strategy Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Worker Agent)&lt;/i&gt;&lt;br/&gt;Campaign targets, budget allocation\&quot;]:::worker\n        CREATIVE[\&quot;&lt;b&gt;Creative Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Worker Agent)&lt;/i&gt;&lt;br/&gt;Ad copy, hooks, creative variants\&quot;]:::worker\n    end\n\n    %% GOVERNANCE GATEWAY (HITL)\n    subgraph GOV_GATE [5. Action Governance Boundary]\n        HITL{\&quot;&lt;b&gt;Human Approval&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Quality &amp; Budget Gate)&lt;/i&gt;&lt;br/&gt;• Brand compliance check&lt;br/&gt;• Spend authorization&lt;br/&gt;• Side-effect clearance\&quot;}:::hitl\n    end\n\n    %% EXTERNAL CAPABILITY &amp; ACTUATION PLANE\n    subgraph ACTION_PLANE [6. Outbound Actuation Plane]\n        MCP_ACTION[\&quot;&lt;b&gt;Ad Platform MCP Boundary&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Service-side API authentication&lt;/i&gt;\&quot;]:::mcp\n        META[\&quot;&lt;b&gt;Meta Ads API&lt;/b&gt;\&quot;]:::external\n        TIKTOK[\&quot;&lt;b&gt;TikTok Ads API&lt;/b&gt;\&quot;]:::external\n        GOOGLE[\&quot;&lt;b&gt;Google Ads API&lt;/b&gt;\&quot;]:::external\n    end\n\n    %% TELEMETRY &amp; CONTINUOUS LEARNING\n    subgraph FEEDBACK_PLANE [7. Telemetry &amp; Closed-Loop Feedback]\n        METRICS[\&quot;&lt;b&gt;Performance Data&lt;/b&gt;&lt;br/&gt;CTR, CPA, ROAS, Conversions\&quot;]:::external\n        LEARN[\&quot;&lt;b&gt;Learning Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Worker Agent)&lt;/i&gt;&lt;br/&gt;Attribution, drift &amp; insight extraction\&quot;]:::worker\n    end\n\n    %% FLOW CONNECTIONS\n    %% Orchestration Delegation\n    ORCH &lt;--&gt;|Task Grant / Scoped Intel| COMP\n    ORCH &lt;--&gt;|Task Grant / Scoped Voice| VOICE\n    ORCH &lt;--&gt;|Evidence Request / Grounded Chunks| RAG_MGR\n\n    %% Data Retrieval\n    RAG_MGR &lt;--&gt;|Read Request| MCP_DATA\n    MCP_DATA &lt;--&gt; DB\n    MCP_DATA &lt;--&gt; WEB\n\n    %% Production Delegation\n    ORCH --&gt;|Decomposed Briefs + Context| STRAT\n    ORCH --&gt;|Decomposed Briefs + Assets| CREATIVE\n    STRAT &lt;--&gt;|Strategic Alignment| CREATIVE\n\n    %% Action Proposal to HITL\n    STRAT --&gt;|Campaign Proposal &amp; Budget| HITL\n    CREATIVE --&gt;|Creative Packages &amp; Copy| HITL\n\n    %% Execution through MCP\n    HITL --&gt;|Approved &amp; Signed Payload| MCP_ACTION\n    HITL -.-&gt;|Rejection / Revision Directive| ORCH\n    MCP_ACTION --&gt; META\n    MCP_ACTION --&gt; TIKTOK\n    MCP_ACTION --&gt; GOOGLE\n\n    %% Feedback Loop\n    META --&gt; METRICS\n    TIKTOK --&gt; METRICS\n    GOOGLE --&gt; METRICS\n    METRICS --&gt; LEARN\n    LEARN -.-&gt;|&lt;b&gt;Continuous Learning Loop&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Validated Insights &amp; Memory Promotion&lt;/i&gt;| ORCH&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CUDhMBtbQreBq1B5f8Qv-92">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
