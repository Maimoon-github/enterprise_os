  <diagram id="intelligence-engine-flow" name="Intelligence Engine Flow">
    <mxGraphModel dx="1400" dy="2610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2610" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="n2" value="Intelligence Engine — Reconstructed Logical Flow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F1F1F;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="900" height="50" as="geometry"/></mxCell>
<mxCell id="n3" value="INPUTS / PREREQUISITES" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1360" height="24" as="geometry"/></mxCell>
<mxCell id="n4" value="eDerma Knowledge Layer&lt;br&gt;• Product information&lt;br&gt;• Ingredients&lt;br&gt;• Benefits&lt;br&gt;• Usage&lt;br&gt;• Warnings&lt;br&gt;• Evidence&lt;br&gt;• Brand knowledge&lt;br&gt;• Rules &amp; strategic constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="260" height="190" as="geometry"/></mxCell>
<mxCell id="n5" value="Customer Voice Data&lt;br&gt;• Customer comments&lt;br&gt;• Reviews&lt;br&gt;• WhatsApp / customer-service data&lt;br&gt;• Sales interviews&lt;br&gt;• Beautician feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="260" height="190" as="geometry"/></mxCell>
<mxCell id="n6" value="Competitor Intelligence&lt;br&gt;• Competitor screenshots&lt;br&gt;• Ads&lt;br&gt;• Comments&lt;br&gt;• Reviews&lt;br&gt;• Product information&lt;br&gt;• Pricing / offers&lt;br&gt;• Influencer / content observations&lt;br&gt;• Historical changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="130" width="260" height="190" as="geometry"/></mxCell>
<mxCell id="n7" value="eDerma Marketing History&lt;br&gt;• Existing campaigns&lt;br&gt;• Creative assets&lt;br&gt;• Past results&lt;br&gt;• Winning / losing concepts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="260" height="190" as="geometry"/></mxCell>
<mxCell id="n8" value="Performance &amp; Learning Records&lt;br&gt;(when available)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="260" height="190" as="geometry"/></mxCell>
<mxCell id="n9" value="1. Retrieve Relevant Knowledge&lt;br&gt;Retrieve relevant: Evidence → customer observations → competitor observations → historical eDerma data → performance history, using both structured records and semantic retrieval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="360" width="900" height="130" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n4" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n15" value="2. Analyze Customer Voice&lt;br&gt;Structure customer observations into:&lt;br&gt;• Problems&lt;br&gt;• Questions&lt;br&gt;• Objections&lt;br&gt;• Desired outcomes&lt;br&gt;• Purchase triggers&lt;br&gt;• Sentiment&lt;br&gt;• Relevant product / category&lt;br&gt;Do not treat individual observations as proof of product effectiveness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="530" width="900" height="210" as="geometry"/></mxCell>
<mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n9" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n17" value="3. Analyze Competitor Intelligence&lt;br&gt;Identify and compare:&lt;br&gt;• Competitor positioning&lt;br&gt;• Products&lt;br&gt;• Prices / offers&lt;br&gt;• Hooks&lt;br&gt;• Visual / content formats&lt;br&gt;• Customer feedback&lt;br&gt;• Objections&lt;br&gt;• Questions&lt;br&gt;• Ad patterns&lt;br&gt;• Engagement observations&lt;br&gt;• Historical changes&lt;br&gt;Derive observable patterns rather than assuming a competitor tactic will succeed for eDerma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="780" width="900" height="300" as="geometry"/></mxCell>
<mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n19" value="4. Combine Evidence&lt;br&gt;Cross-reference: Customer Voice + Competitor Intelligence + Product/Evidence + eDerma History + Performance History" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1120" width="900" height="100" as="geometry"/></mxCell>
<mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n21" value="5. Generate Structured Insights&lt;br&gt;Produce:&lt;br&gt;• Customer problems&lt;br&gt;• Customer desires&lt;br&gt;• Questions&lt;br&gt;• Objections&lt;br&gt;• Competitor strengths&lt;br&gt;• Competitor weaknesses&lt;br&gt;• Market opportunities&lt;br&gt;• Emerging topics&lt;br&gt;• Content opportunities&lt;br&gt;Each insight retains its supporting sources / provenance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1260" width="900" height="260" as="geometry"/></mxCell>
<mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n23" value="6. Evaluate Evidence Strength&lt;br&gt;Assign HIGH / MEDIUM / LOW confidence according to available evidence.&lt;br&gt;Do not equate frequency with factual proof." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1560" width="900" height="130" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n25" value="Adequate&lt;br&gt;evidence&lt;br&gt;available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="1545" width="160" height="160" as="geometry"/></mxCell>
<mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n27" value="INSUFFICIENT&lt;br&gt;EVIDENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="1780" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="e28" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n29" value="7. Apply Knowledge &amp; Safety Constraints&lt;br&gt;Priority order: Rules → Product information → Evidence → Brand strategy → Historical performance → Market intelligence → AI inference.&lt;br&gt;AI inference must not override higher-priority information; unsupported or risky claims are flagged, not treated as fact." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1730" width="900" height="170" as="geometry"/></mxCell>
<mxCell id="e30" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n25" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n31" value="8. Produce Evidence-Backed Intelligence Output&lt;br&gt;Retain: Recommendation → Why → Evidence → Sources → Date → Confidence → What could disprove it → Suggested test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1940" width="900" height="110" as="geometry"/></mxCell>
<mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n33" value="9. Pass Intelligence to Strategy Engine&lt;br&gt;Validated intelligence → Strategy Engine.&lt;br&gt;The Intelligence Engine does not directly become published content." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="2090" width="900" height="130" as="geometry"/></mxCell>
<mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n35" value="Strategy Engine&lt;br&gt;(downstream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="2090" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="e36" value="Validated&lt;br&gt;intelligence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n33" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n37" value="Creative Engine&lt;br&gt;(downstream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="2190" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;fontSize=10;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n39" value="10. Receive Future Learning Inputs&lt;br&gt;Recommendation → Human decision → Creative → Campaign → Result → Human interpretation → Learning record → Future Intelligence.&lt;br&gt;Accumulated learning becomes available for future retrieval and analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="2260" width="900" height="150" as="geometry"/></mxCell>
<mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n33" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n41" value="TERMINATION / LOOP&lt;br&gt;Intelligence output delivered to Strategy Engine → downstream campaign / performance data returns to Knowledge Layer → Intelligence Engine retrieves updated knowledge → next analysis cycle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="2450" width="900" height="100" as="geometry"/></mxCell>
<mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n39" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e43" value="next analysis cycle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=10;strokeColor=#D6B656;fontColor=#D6B656;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n41" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-40" y="2500"/><mxPoint x="-40" y="225"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
