# ==============================================================================
# Agentic Brand Marketing OS - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDEs
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (Keep .env.example tracked)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Python & Virtual Environments (uv, pip, venv)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Type Checking & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json

# Jupyter & Scratch Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Celery & Background Workers
celerybeat-schedule*
celerybeat.pid
.pids/
logs/

# ------------------------------------------------------------------------------
# Node.js, Next.js & Frontend Tooling
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
out/

# Turbo & Cache
.turbo/
.cache/
.parcel-cache/

# TypeScript declarations build cache
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# Databases, Object Storage & Local Service Persistence
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
dump.rdb

# Container & Service Mount Data (preserve directory structure via .gitkeep)
data/
*.log
infra/postgres/data/
infra/redis/data/
infra/minio/data/
infra/qdrant/storage/
infra/ollama/models/

# Ephemeral sandbox workspaces & temporary execution dumps
/tmp/
*.tmp
*.temp
/sandboxes/
.sandbox/
workspace_tmp/

# ------------------------------------------------------------------------------
# Observability & Local Evaluation Exports
# ------------------------------------------------------------------------------
observability/eval_reports/
*.trace.json
