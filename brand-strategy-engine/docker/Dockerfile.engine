FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml and install Python dependencies
COPY pyproject.toml /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Copy source tree and configuration
COPY .config/ /app/.config/
COPY src/ /app/src/
COPY internal_sandbox/ /app/internal_sandbox/

RUN mkdir -p /app/evidence_blobs /app/user_documents

EXPOSE 8000

ENV CONFIG_PATH=/app/.config/config.toml

CMD ["python", "-m", "uvicorn", "src.runtime.api:app", "--host", "0.0.0.0", "--port", "8000"]
