# ==========================================
# Agentic Brand Marketing OS - Environment
# ==========================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (App persistence & LangGraph PostgresSaver checkpointer)
POSTGRES_USER=marketing_os
POSTGRES_PASSWORD=marketing_os_secret
POSTGRES_DB=marketing_os_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://marketing_os:marketing_os_secret@localhost:5432/marketing_os_db
SYNC_DATABASE_URL=postgresql://marketing_os:marketing_os_secret@localhost:5432/marketing_os_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Ollama Local LLM & Embeddings Gateway
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_SUPERVISOR=llama3.3:70b
OLLAMA_MODEL_WORKER=qwen2.5:14b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_secret
MINIO_BUCKET_RAW=marketing-raw-assets
MINIO_BUCKET_GENERATED=marketing-generated-assets
MINIO_BUCKET_EXPORTS=marketing-exports
MINIO_USE_SSL=false

# OpenTelemetry & Observability (Langfuse primary, Phoenix optional)
OTEL_SERVICE_NAME=agentic-marketing-os
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LANGFUSE_PUBLIC_KEY=pk-lf-local-key
LANGFUSE_SECRET_KEY=sk-lf-local-secret
LANGFUSE_HOST=http://localhost:3001
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# Rootless Podman Sandbox Engine
PODMAN_SOCKET_PATH=/run/user/1000/podman/podman.sock
SANDBOX_IMAGE=marketing-os-worker-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# Social Gateway MCP Server - Encrypted Secrets Backend
ENCRYPTION_MASTER_KEY=change_this_to_32_bytes_base64_encoded_key_for_secrets
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_API_KEY=
X_API_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# External Media Generation Providers (Fallback / Enhancers)
COMFYUI_ENDPOINT=http://localhost:8188
OPENAI_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
