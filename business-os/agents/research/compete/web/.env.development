# Local development defaults (loaded automatically by `next dev`).
#
# Run the dashboard against the pre-baked JSON under /api-static instead of a
# live FastAPI backend. Without this, every request is proxied to
# http://127.0.0.1:8000 (see next.config.mjs); with no backend running that
# yields ECONNREFUSED on every call, React Query retries each one, and the
# dashboard hangs with no data. Setting static mode makes dev load instantly
# and match the production demo.
#
# To develop against a real local backend instead, set this to 0 (or delete
# this file) and start FastAPI on port 8000.
NEXT_PUBLIC_STATIC_DATA=1
