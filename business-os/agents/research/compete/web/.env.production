# Production build runs server-less: the dashboard reads pre-baked JSON from
# /api-static (generated by scripts/export_static_data.py) instead of a live
# FastAPI backend. This is what makes the prod deploy cost $0 (static hosting
# only). Set to 0 (or remove) if you wire up a real hosted API.
NEXT_PUBLIC_STATIC_DATA=1

# Absolute site URL for canonical + OG/Twitter tags. Override in the Vercel
# project settings with the real deploy domain.
NEXT_PUBLIC_SITE_URL=https://compete.yerradouani.me
